# config.env - machine-specific values read by every module. Copy to config.env and edit.
# Plain KEY=value, sourced by bash. No secrets here (no passwords, no tokens).

# Identity
TARGET_USER="alexponce"                  # Linux login created by the installer (lowercase only)
HOSTNAME_TARGET="strix"
GIT_NAME="aleponce4"
GIT_EMAIL="aleponce92@gmail.com"
TIMEZONE="America/Chicago"               # Memphis / UTHSC

# Disks (stable ids; check with: ls -l /dev/disk/by-id/)
NVME_ID="/dev/disk/by-id/nvme-Samsung_SSD_990_PRO_with_Heatsink_1TB_0025_3848_4140_33A2"
SATA_SSD_ID="/dev/disk/by-id/ata-Samsung_SSD_860_EVO_500GB_S3Z1NY0M404409Z"
HDD_ID="/dev/disk/by-id/ata-HGST_HUH728080ALE604_VLJAA2TY"
DATA_MOUNT="/data"                       # SATA SSD, Btrfs
BACKUP_MOUNT="/backup"                   # HDD Btrfs partition (after the 2 TB NTFS WINRESCUE partition)
WINRESCUE_LABEL="WINRESCUE"              # NTFS partition made from Windows; mounted read-only at /mnt/winrescue

# Feature switches
AUTO_FORMAT="yes"                        # 20-storage may format the SATA SSD (-> /data) and the HDD's free space (-> /backup) without a typed
                                         # confirmation. Devices are matched by serial number (SATA_SSD_ID/HDD_ID); the NTFS WINRESCUE partition is never touched.
LINUX_SETUP_REPO="https://github.com/aleponce4/linux-setup.git"
ENABLE_SNAPSHOTS="yes"                   # Timeshift (btrfs) + timeshift-autosnap-apt + grub-btrfs
ENABLE_BTRBK="yes"                       # hourly send/receive of @, @home, @data to /backup
ENABLE_INTEL_COMPUTE="yes"               # Level Zero / OpenCL runtime (PyTorch XPU, OpenVINO)
ENABLE_DICTATION="yes"                   # Speech Note flatpak + ydotool
ENABLE_AGENT_SUDO="yes"                  # passwordless sudo for apt/flatpak/systemctl/... so agents can administer the machine
LOGIN_SHELL="bash"                       # bash (HPC- and agent-friendly, default) or zsh; both get the same prompt/hooks/aliases
ENABLE_CRD="yes"                         # Chrome Remote Desktop host (runs a virtual X11 Plasma session; authorize once in the browser)
ENABLE_RESTIC="yes"                      # daily encrypted restic backup of /data, /home, /etc to /backup/restic (+ weekly integrity check)
ENABLE_DISTROBOX="yes"                   # distrobox + the boxes in lists/distroboxes.txt (an Arch userland on demand, host stays Kubuntu)
WALLPAPER=""                             # absolute path to an image; when set it is applied to desktop, lock screen and login screen
ENABLE_TILING_SCRIPT="yes"               # install Polonium (KWin auto-tiling); stays disabled until toggled
ENABLE_APPTAINER="yes"                   # Apptainer for HPC-style containers
ENABLE_VM_STACK="no"                     # qemu/KVM + virt-manager (not needed: no Windows VM)
ENABLE_DROPBOX="no"                      # Dropbox daemon (not needed: browser only)
ENABLE_ONEDRIVE="no"                     # abraunegg onedrive client (not needed: browser only)

# Work layout
WORK_DIR="$HOME/work"                    # git repos
DATA_DIRS="libs onteko seed datasets scratch"   # created under $DATA_MOUNT; ~/data -> /data

# Versions / URLs that change over time (modules skip when empty)
R_CRAN_CODENAME="resolute"               # Ubuntu 26.04
RSTUDIO_DEB_URL="https://download1.rstudio.org/electron/jammy/amd64/rstudio-2026.08.2-200-amd64.deb"   # "Ubuntu 22/24/26" build, verified 2026-09-02 at https://docs.posit.co/ide/user/
CURSOR_DEB_URL=""                        # from https://cursor.com/downloads (x64 .deb); leave empty to skip Cursor
CHIMERAX_DEB_URL=""                      # requires registration at https://www.rbvi.ucsf.edu/chimerax/download.html
MEGA_DEB_URL=""                          # from https://www.megasoftware.net/ (Ubuntu .deb, GUI)
CISCO_SECURE_CLIENT_TARBALL=""           # optional: cisco-secure-client-linux64-5.x.tar.gz from the UTHSC VPN portal
NODE_VERSION="24"
PYTHON_VERSIONS="3.12 3.11"
