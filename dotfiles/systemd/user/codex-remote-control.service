[Unit]
Description=Codex app-server daemon with remote control (experimental), for the ChatGPT app
After=default.target

[Service]
# Requires the standalone Codex install (module 40). Pair a device once: codex remote-control pair
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/codex remote-control start
ExecStop=%h/.local/bin/codex remote-control stop

[Install]
WantedBy=default.target
