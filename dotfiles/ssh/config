# ~/.ssh/config (managed by linux-setup). Private keys are NOT in the repo; restore ~/.ssh/id_ed25519 from the secrets archive.

# The old "uthsc-wsl" host is gone: it pointed at the WSL instance on the Windows machine this replaced.

# ISAAC-NG (UT HPC). Cluster guide: ~/work/tools/isaac-hpc.
Host isaac
  HostName login.isaac.utk.edu
  User aponcefl

Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ServerAliveCountMax 4
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
