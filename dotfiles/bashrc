# ~/.bashrc (managed by linux-setup; edit in the repo, not here)
case $- in *i*) ;; *) return ;; esac

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
export EDITOR="code --wait"
export VISUAL="$EDITOR"
export LANG=en_US.UTF-8

# history: big, shared across terminals, no dups
HISTSIZE=200000; HISTFILESIZE=400000; HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize autocd cdspell dirspell globstar
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# completion
[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
bind 'set completion-ignore-case on' 2>/dev/null
bind 'set show-all-if-ambiguous on' 2>/dev/null

# tool hooks (each guarded so a missing tool never breaks the shell)
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"
command -v atuin    >/dev/null && eval "$(atuin init bash --disable-up-arrow)"
command -v direnv   >/dev/null && eval "$(direnv hook bash)"
[ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && . /usr/share/doc/fzf/examples/key-bindings.bash
[ -f /usr/share/doc/fzf/examples/completion.bash ]   && . /usr/share/doc/fzf/examples/completion.bash
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

# node (fnm), conda (micromamba)
export FNM_PATH="$HOME/.local/share/fnm"
[ -d "$FNM_PATH" ] && { export PATH="$FNM_PATH:$PATH"; eval "$(fnm env --use-on-cd --shell bash)"; }
export MAMBA_ROOT_PREFIX="$HOME/micromamba"
command -v micromamba >/dev/null && eval "$(micromamba shell hook -s bash)"
alias conda=micromamba

# aliases
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -l --git --group-directories-first --icons=auto'
alias la='eza -la --git --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --icons=auto'
alias cat='bat --paging=never --style=plain'
alias du='dust'
alias df='duf'
alias top='btop'
alias lg='lazygit'
alias g='git'
alias ..='cd ..'
alias ...='cd ../..'
alias open='xdg-open'
alias r='radian'
alias venv='uv venv && source .venv/bin/activate'
alias snapnow='sudo timeshift --create --comments "manual $(date +%F_%T)"'
alias reload='exec bash'

# terminal title
PROMPT_COMMAND="printf '\033]0;%s\007' \"\${PWD/#\$HOME/~}\";$PROMPT_COMMAND"
