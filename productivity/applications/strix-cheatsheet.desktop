[Desktop Entry]
Type=Application
Name=Strix Cheat Sheet
GenericName=Shortcuts and daily commands
Comment=Keyboard shortcuts, workspaces, agent prefixes and AI actions for this workstation
Exec=/bin/sh -lc "$HOME/.local/bin/strix-cheatsheet"
Icon=help-hint
Terminal=false
Categories=Documentation;Utility;
Keywords=cheatsheet;shortcuts;help;keys;reference;strix;
StartupNotify=false
X-Linux-Setup-Owner=productivity
